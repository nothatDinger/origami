+struct Slot {
+  CpaDcDpOpData* op = nullptr;
+  uint8_t* dst = nullptr;
+  uint32_t dst_capacity = 0;
+  std::unique_ptr<DpSgl> dst_sgl;
+  std::atomic<int> done{1};
+  uint32_t expected_output = 0;
+  uint64_t chunk_index = 0;
+  bool failed = false;
