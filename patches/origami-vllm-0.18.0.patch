+    kv_tensor: torch.Tensor,
+    metadata: dict[str, Any],
+    token_count: int,
+) -> torch.Tensor:
+    token_count = int(token_count)
+    if token_count <= 0:
+        return kv_tensor
+    axis = _token_axis_from_metadata(metadata)
+    if axis is None or axis >= kv_tensor.dim():
+        return kv_tensor
+    available = int(kv_tensor.shape[axis])
